        "BattleRecommendedDeck": {
            "type": "switch",
            "label": "$option.BattleRecommendedDeck.label",
            "description": "$option.BattleRecommendedDeck.description",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "label": "$option.BattleRecommendedDeck.No.label",
                    "pipeline_override": {
                        "StepUpBattle_DeckPolicyFlow": {
                            "next": [
                                "StepUpBattle_ClickStartBattle"
                            ]
                        },
                        "EventBattle2026_DeckPolicyFlow": {
                            "next": [
                                "EventBattle2026_ClickStartBattle"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "$option.BattleRecommendedDeck.Yes.label",
                    "pipeline_override": {
                        "StepUpBattle_DeckPolicyFlow": {
                            "next": [
                                "BattleEntry_SelectRecommendedDeck"
                            ]
                        },
                        "EventBattle2026_DeckPolicyFlow": {
                            "next": [
                                "BattleEntry_SelectRecommendedDeck"
                            ]
                        }
                    }
                }
            ]
