{
    "task": [
        {
            "name": "Battle",
            "label": "$task.Battle.label",
            "description": "$task.Battle.description",
            "entry": "BattleEntry_Start",
            "controller": [
                "ADB"
            ],
            "resource": [
                "Default",
                "Dev"
            ],
            "group": [
                "DailyRoutine"
            ],
            "option": [
                "BattleMode",
                "BattleContinue"
            ]
        }
    ],
    "option": {
        "BattleContinue": {
            "type": "switch",
            "label": "$option.BattleContinue.label",
            "description": "$option.BattleContinue.description",
            "default_case": "No",
            "cases": [
                {
                    "name": "No",
                    "label": "$option.BattleContinue.No.label",
                    "description": "$option.BattleContinue.No.description",
                    "pipeline_override": {
                        "Battle_FinishFlow": {
                            "next": [
                                "Battle_FinishReturnHomeFlow"
                            ]
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "$option.BattleContinue.Yes.label",
                    "description": "$option.BattleContinue.Yes.description",
                    "pipeline_override": {
                        "Battle_FinishFlow": {
                            "next": [
                                "[Anchor]Battle_ContinueTarget"
                            ]
                        }
                    }
                }
            ]
        },
        "BattleMode": {
            "type": "select",
            "label": "$option.BattleMode.label",
            "description": "$option.BattleMode.description",
            "default_case": "EventBattle",
            "cases": [
                {
                    "name": "EventBattle",
                    "label": "$option.BattleMode.EventBattle.label",
                    "description": "$option.BattleMode.EventBattle.description",
                    "option": [
                        "BattleAutoRecovery"
                    ],
                    "pipeline_override": {
                        "BattleEntry_ModeFlow": {
                            "next": [
                                "EventBattle_Start"
                            ]
                        }
                    }
                },
                {
                    "name": "EventBattle2026Rerun",
                    "label": "$option.BattleMode.EventBattle2026Rerun.label",
                    "description": "$option.BattleMode.EventBattle2026Rerun.description",
                    "option": [
                        "EventBattle2026Deck",
                        "BattleRecommendedDeck",
                        "BattleAutoRecovery"
                    ],
                    "pipeline_override": {
                        "BattleEntry_ModeFlow": {
                            "next": [
                                "EventBattle2026_Start"
                            ]
                        },
                        "BattleEntry_RecommendedDeckReturned": {
                            "recognition": {
                                "param": {
                                    "roi": [
                                        447,
                                        1064,
                                        116,
                                        59
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "RandomBattle",
                    "label": "$option.BattleMode.RandomBattle.label",
                    "description": "$option.BattleMode.RandomBattle.description",
                    "pipeline_override": {
                        "BattleEntry_ModeFlow": {
                            "next": [
                                "RandomBattle_Start"
                            ]
                        }
                    }
                },
                {
                    "name": "StepUpBattle",
                    "label": "$option.BattleMode.StepUpBattle.label",
                    "description": "$option.BattleMode.StepUpBattle.description",
                    "option": [
                        "BattleRecommendedDeck"
                    ],
                    "pipeline_override": {
                        "BattleEntry_ModeFlow": {
                            "next": [
                                "StepUpBattle_Start"
                            ]
                        }
                    }
                }
            ]
        },
        "EventBattle2026Deck": {
            "type": "select",
            "label": "$option.EventBattle2026Deck.label",
            "description": "$option.EventBattle2026Deck.description",
            "default_case": "Stage1",
