{
    "task": [
        {
            "name": "Share",
            "label": "$task.Share.label",
            "description": "$task.Share.description",
            "entry": "Share_Start",
            "controller": [
                "ADB"
            ],
            "resource": [
                "Default",
                "Dev"
            ],
            "group": [
                "DailyRoutine"
            ],
            "option": [
                "ShareRecipientStrategy",
                "ShareKeepTwoCards"
            ]
        }
    ],
    "option": {
        "ShareRecipientStrategy": {
            "type": "select",
            "label": "$option.ShareRecipientStrategy.label",
            "description": "$option.ShareRecipientStrategy.description",
            "default_case": "FirstStarredFriend",
            "cases": [
                {
                    "name": "FirstStarredFriend",
                    "label": "$option.ShareRecipientStrategy.FirstStarredFriend.label",
                    "pipeline_override": {
                        "Share_ClickShare": {
                            "next": [
                                "Share_SelectFirstStarredFriend"
                            ]
                        }
                    }
                }
            ]
        },
        "ShareKeepTwoCards": {
            "type": "switch",
            "label": "$option.ShareKeepTwoCards.label",
            "default_case": "Yes",
            "cases": [
                {
                    "name": "No",
                    "label": "$option.ShareKeepTwoCards.No.label",
                    "pipeline_override": {
                        "ShareFilter_WantedCardCount": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "^[1-9][0-9]*$"
                                    ]
                                }
                            }
                        },
                        "ShareFilter_CardCount": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "^[1-9][0-9]*$"
                                    ]
                                }
                            }
                        }
                    }
                },
                {
                    "name": "Yes",
                    "label": "$option.ShareKeepTwoCards.Yes.label",
                    "pipeline_override": {
                        "ShareFilter_WantedCardCount": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "^([3-9]|[1-9][0-9]+)$"
                                    ]
                                }
                            }
                        },
                        "ShareFilter_CardCount": {
                            "recognition": {
                                "param": {
                                    "expected": [
                                        "^([3-9]|[1-9][0-9]+)$"
                                    ]
                                }
                            }
                        }
                    }
                }
            ]
        }
    }
}
